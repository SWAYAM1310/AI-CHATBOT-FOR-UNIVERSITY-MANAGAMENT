# Copy to .env and adjust. docker-compose and the backend both read these.

# --- Postgres (compose provisions this) ---
POSTGRES_USER=uniassist
POSTGRES_PASSWORD=uniassist
POSTGRES_DB=uniassist
# Host port for the container. Not 5432 (a native PostgreSQL install may
# already own it) and not 5433, which is the port other pgvector side
# projects tend to pick for the same reason -- two of them cannot both bind
# it, and the second one fails to start. Change this and DATABASE_URL
# together; they must agree.
POSTGRES_PORT=5434

# --- Backend DB connection ---
DATABASE_URL=postgresql+psycopg://uniassist:uniassist@localhost:5434/uniassist

# --- Embeddings via the Jina API (Phase 3). Get a free key at https://jina.ai ---
# The backend also reads backend/.env, which overrides this file — a good place
# for per-developer secrets.
EMBEDDING_DIM=1024
EMBEDDING_MODEL=jina-embeddings-v5-omni-small
JINA_API_KEY=

# --- LLM provider (Groq, OpenAI-compatible; required from Phase 2) ---
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL_ROUTER=openai/gpt-oss-120b
LLM_MODEL_MAIN=openai/gpt-oss-120b
# Free-tier budget (plan.md §4). Groq's limits are per ORGANISATION, so these
# sit below the published ceiling — an evaluator opening the app mid-demo
# shares it. Raise them only if you know you have the headroom.
LLM_TPM=6000
LLM_RPM=25
LLM_MAX_RETRIES=4
LLM_BACKOFF_BASE=1.0
LLM_BACKOFF_CAP=30.0

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:5173

# --- Auth ---
JWT_SECRET=dev-insecure-change-me-please-0000000000
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# --- Academic context (keep in sync with scripts/academic_data.py) ---
CURRENT_TERM=2026-27-ODD

# --- Email notifications (leave apply/decide) ---
# off = draft/send nothing; console = log only, no network (default, used by
# tests/CI); smtp = actually send, via Mailpit locally or a real provider.
EMAIL_MODE=console
# Off by default so eval runs (which never confirm) don't spend extra LLM
# calls drafting bodies that are never sent. Turn on for local dev/demo.
EMAIL_DRAFT_ENABLED=false
EMAIL_FROM=UniAssist <noreply@sot.pdpu.ac.in>
# Mailpit (docker compose up mailpit) accepts every synthetic address without
# sending anything real. Point this at smtp.gmail.com:587 with an app
# password only for the live demo, and set EMAIL_REDIRECT_TO when you do.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
# Safety net for a real SMTP host: every mail is redirected here regardless
# of recipient, with the true address kept in a header/body banner. Never
# point EMAIL_MODE=smtp at a non-local host without this set (backend/.env
# is the right place for a real address — never commit one here).
EMAIL_REDIRECT_TO=
EMAIL_ALLOWED_DOMAINS=sot.pdpu.ac.in
# While EMAIL_REDIRECT_TO is set, every message lands in one real inbox, so an
# announcement to a whole department would bury it. Only this many recipients
# per announcement are really emailed (spread across students and faculty);
# the rest are recorded as "held". 0 disables the cap. No effect without a redirect.
EMAIL_DEMO_CAP=4
