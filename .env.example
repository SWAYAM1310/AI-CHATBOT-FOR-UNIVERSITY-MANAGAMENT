# Copy to .env and adjust. docker-compose and the backend both read these.

# --- Postgres (compose provisions this) ---
POSTGRES_USER=uniassist
POSTGRES_PASSWORD=uniassist
POSTGRES_DB=uniassist
# Host port for the container. 5433 (not 5432) to avoid clashing with a
# native PostgreSQL install that may already own 5432.
POSTGRES_PORT=5433

# --- Backend DB connection ---
DATABASE_URL=postgresql+psycopg://uniassist:uniassist@localhost:5433/uniassist

# --- Embeddings via the Jina API (Phase 3). Get a free key at https://jina.ai ---
# The backend also reads backend/.env, which overrides this file — a good place
# for per-developer secrets.
EMBEDDING_DIM=1024
EMBEDDING_MODEL=jina-embeddings-v5-omni-small
JINA_API_KEY=

# --- LLM provider (Groq, OpenAI-compatible; required from Phase 2) ---
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL_ROUTER=openai/gpt-oss-20b
LLM_MODEL_MAIN=openai/gpt-oss-120b
# Free-tier budget (plan.md §4). Groq's limits are per ORGANISATION, so these
# sit below the published ceiling — an evaluator opening the app mid-demo
# shares it. Raise them only if you know you have the headroom.
LLM_TPM=6000
LLM_RPM=25
LLM_MAX_RETRIES=4
LLM_BACKOFF_BASE=1.0
LLM_BACKOFF_CAP=30.0

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:5173

# --- Auth ---
JWT_SECRET=dev-insecure-change-me-please-0000000000
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# --- Academic context (keep in sync with scripts/academic_data.py) ---
CURRENT_TERM=2026-27-ODD
